# ---- PlatformIO build output (all compiled files end up under .pio/) ----
.pio/
.pioenvs/
.piolibdeps/
compile_commands.json

# ---- editor files the PlatformIO VS Code extension generates ----
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.clangd/

# ---- stray compiled objects if anyone builds outside .pio/ ----
*.o
*.d
*.elf
*.hex
*.map

# ---- your WiFi credentials - never commit these ----
include/wifi_credentials.h
# the old v3.13 name; if you still have this file, delete it (on Windows it
# shadows the ESP32 library header <WiFi.h>) - until then it stays ignored
include/wifi.h
