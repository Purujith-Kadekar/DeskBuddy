# Cloud planner - env vars
# Copy to .env.local for local dev; set in Vercel Project Settings -> Environment Variables for prod.

# Shared secret between devices and the API (optional but recommended).
# The firmware sends the same value in wifi_credentials.h as CLOUD_API_KEY.
SYNC_API_KEY=change-me-to-a-long-random-string

# ---- Firebase / Firestore (server-side, service account) ----
# Paste the full JSON of a service-account key here as ONE line.
# Firestore mode activates only when this is present; without it the app
# runs on the built-in mock store (in-memory + /tmp JSON file).
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Firestore rules for this app (see ARCHITECTURE.md): the API only ever
# touches planner/main from the server, so client access can stay denied.

# Vercel refuses the temporary mock store unless this is 1 (demo only - data is NOT kept).
# ALLOW_MOCK_ON_VERCEL=1
